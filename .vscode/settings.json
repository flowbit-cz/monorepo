{
  "i18n-ally.localesPaths": ["packages/i18n/src/messages", "apps/template/src/i18n/locales"],
  "i18n-ally.keystyle": "nested",
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "pattern": "apps/*" }, { "pattern": "packages/*" }],

  // Hidden in the explorer: dependencies, build output, test reports, generated code and
  // config files you rarely open. Set an entry to false to show it again.
  "files.exclude": {
    // OS / git
    "**/.git": true,
    "**/.DS_Store": true,
    // dependencies
    "**/node_modules": true,
    "**/.pnpm-store": true,
    // build output & caches
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/out": true,
    "**/storybook-static": true,
    "**/*.tsbuildinfo": true,
    "**/next-env.d.ts": true,
    // test reports
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/blob-report": true,
    "**/reports": true,
    "**/.stryker-tmp": true,
    // generated code (Orval clients, design token CSS), regenerated by `pnpm generate`
    "**/src/generated": true,
    "**/AGENTS.md": true,
    // tooling config you rarely open
    "pnpm-lock.yaml": true,
    ".husky": true,
    ".npmrc": true,
    ".nvmrc": true,
    ".prettierrc.mjs": true,
    ".prettierignore": true,
    "commitlint.config.mjs": true
  },

  // Search skips the same noise (and the lockfile).
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/storybook-static": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/reports": true,
    "**/src/generated": true,
    "pnpm-lock.yaml": true
  },

  // Don't watch build output (faster editor in a big monorepo).
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/storybook-static/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true
  },

  // Group related files under their parent in the explorer (e.g. Button.test.tsx under Button.tsx).
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.tsx": "${capture}.test.tsx, ${capture}.stories.tsx, ${capture}.form.ts, ${capture}.form.test.ts",
    "*.ts": "${capture}.test.ts, ${capture}.d.ts, ${capture}.d.mts",
    "*.mjs": "${capture}.d.mts",
    "package.json": "pnpm-workspace.yaml, turbo.json, tsconfig.json, eslint.config.mjs, vitest.config.mts, stryker.config.mjs, playwright.config.ts, next.config.ts, postcss.config.mjs, .env.example, .env",
    "README.md": "CLAUDE.md, AGENTS.md"
  }
}
