{
  "name": "@dertour/server",
  "version": "0.0.0",
  "private": true,
  "description": "Server-side helpers for BFF route handlers and server actions: errors, handler wrapper, JSON logger, rate limit",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@dertour/core": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
    "@dertour/eslint-config": "workspace:*",
    "@dertour/tsconfig": "workspace:*",
    "@dertour/vitest-config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
