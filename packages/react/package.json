{
  "name": "@dertour/react",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic React: hooks and providers shared by web (Next.js) and React Native apps",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19"
  },
  "devDependencies": {
    "@dertour/eslint-config": "workspace:*",
    "@dertour/testing": "workspace:*",
    "@dertour/tsconfig": "workspace:*",
    "@dertour/vitest-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
