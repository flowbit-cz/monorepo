{
  "$description": "DERTOUR design tokens. PLACEHOLDER values: replace them with the official DERTOUR design system (the dertour.de CSS uses a --dto-* prefix).",
  "color": {
    "brand": { "DEFAULT": "#0a2d5c", "light": "#1d4f8f", "dark": "#061c3a", "contrast": "#ffffff" },
    "accent": { "DEFAULT": "#f2b705", "dark": "#c99700", "contrast": "#0a2d5c" },
    "surface": { "DEFAULT": "#ffffff", "muted": "#f4f6f9", "inverted": "#0a2d5c" },
    "text": { "DEFAULT": "#111827", "muted": "#4b5563", "inverted": "#ffffff" },
    "border": { "DEFAULT": "#d1d5db", "strong": "#9ca3af" },
    "success": { "DEFAULT": "#15803d", "contrast": "#ffffff" },
    "warning": { "DEFAULT": "#b45309", "contrast": "#ffffff" },
    "danger": { "DEFAULT": "#b91c1c", "contrast": "#ffffff" },
    "focus": { "DEFAULT": "#2c79c0" }
  },
  "font": {
    "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "serif": "ui-serif, Georgia, Cambria, \"Times New Roman\", serif"
  },
  "radius": { "sm": "0.25rem", "md": "0.5rem", "lg": "0.75rem", "xl": "1rem", "pill": "9999px" },
  "shadow": {
    "card": "0 1px 3px 0 rgb(17 24 39 / 0.08), 0 1px 2px -1px rgb(17 24 39 / 0.08)",
    "raised": "0 10px 25px -5px rgb(17 24 39 / 0.15)"
  },
  "breakpoint": { "sm": "40rem", "md": "48rem", "lg": "64rem", "xl": "80rem" }
}
