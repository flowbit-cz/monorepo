{
  "name": "@dertour/api",
  "version": "0.0.0",
  "private": true,
  "description": "API clients generated by Orval from backend OpenAPI specs: fetch functions (server), React Query hooks (client), zod schemas, MSW mocks",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./offers": "./src/generated/offers/endpoints/index.ts",
    "./offers/model": "./src/generated/offers/model/index.ts",
    "./offers/query": "./src/generated/offers/query/index.ts",
    "./offers/zod": "./src/generated/offers/zod/index.zod.ts",
    "./mocks": "./src/mocks/handlers.ts",
    "./mocks/node": "./src/mocks/node.ts",
    "./mocks/browser": "./src/mocks/browser.ts",
    "./mocks/demo": "./src/mocks/demo/index.ts"
  },
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@dertour/core": "workspace:*",
    "@faker-js/faker": "catalog:",
    "msw": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@dertour/eslint-config": "workspace:*",
    "@dertour/tsconfig": "workspace:*",
    "@dertour/vitest-config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "orval": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
