# ---- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Backend
# Server-side base URL of the backend API (Server Components, route handlers).
API_BASE_URL=https://api.example.test
# Browser-side base URL (client components / React Query). Often a public gateway.
NEXT_PUBLIC_API_BASE_URL=https://api.example.test

# ---- API mocking (MSW). Lets the app run without a backend (dev, E2E, demos).
# Turn both off once a real backend is available.
API_MOCKING=enabled
NEXT_PUBLIC_API_MOCKING=enabled

# ---- Optional integrations (left out when empty)
NEXT_PUBLIC_USERCENTRICS_SETTINGS_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_ENV=local

# ---- Logging
LOG_LEVEL=debug
