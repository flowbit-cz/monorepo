{
  "extends": "@dertour/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "*.config.ts",
    "*.config.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
