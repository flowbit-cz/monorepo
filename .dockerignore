# Build context = monorepo root. Send only sources: dependencies are installed and
# API clients/tokens are generated inside the image.

# dependencies & package manager stores
**/node_modules
.pnpm-store

# build output & caches
**/.next
**/.turbo
**/dist
**/out
**/storybook-static
**/*.tsbuildinfo
**/next-env.d.ts

# generated code (regenerated by `pnpm generate` during the build)
**/src/generated/*
!**/src/generated/.gitignore

# tests & reports
**/coverage
**/playwright-report
**/test-results
**/blob-report
**/reports
**/.stryker-tmp

# secrets & local env (runtime env comes from the orchestrator)
**/.env
**/.env*.local

# editor, git, AI tooling, CI
.git
.github
.husky
.vscode
.claude
.mcp.json
**/.DS_Store
**/*.log
